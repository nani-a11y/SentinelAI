# SentinelAI Environment Configuration

# Server
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinelai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5.0

# LLM Reverse Proxy & Provider Configuration
DEFAULT_LLM_PROVIDER=ollama
LLM_DEFAULT_TIMEOUT_SECONDS=60.0

# Ollama Provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=60.0

# Gemini Provider (credentials must be provided via environment, never committed)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60.0

# Input Security Engine Configuration
SECURITY_ENABLED=true
SECURITY_BLOCK_THRESHOLD=0.60
SECURITY_BLOCK_STATUS_CODE=403

# Context, Data & Tool Security Configuration
SECURITY_BLOCK_ON_SECRETS=true
SECURITY_REDACT_PII=false
SECURITY_ALLOWED_TOOLS=["calculator","search_docs","get_weather","read_metric","query_database"]
SECURITY_BLOCKED_TOOLS=["execute_bash","run_command","shell_exec","eval_code","system_exec","delete_database"]

# Output Protection Configuration
OUTPUT_PROTECTION_ENABLED=true
OUTPUT_REDACT_PII=true
OUTPUT_REDACT_SECRETS=true
OUTPUT_BLOCK_CRITICAL_LEAKS=true
OUTPUT_DETECT_PROMPT_LEAKAGE=true
